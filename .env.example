# ============================================================
# Codebase Navigator 环境配置
# 默认使用 OpenRouter 免费模型 z-ai/glm-5.2:free（0 费用），无需信用卡
# 填一个提供商即可；其余可留空
# ============================================================

# OpenRouter（默认，免费模型多，含 z-ai/glm-5.2:free） https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# DeepSeek（国内直连、便宜） https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_key_here

# Groq（免费，速度快） https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# OpenAI
OPENAI_API_KEY=sk-your_key_here

# 自定义任意 OpenAI 兼容服务（本地 Ollama / one-api 等），设置后优先生效
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:7b
